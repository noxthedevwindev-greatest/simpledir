#!/usr/bin/env python3
"""simpledir - the next zoxide. named directory shortcuts for your shell.

Config lives in ~/.simpledir/config.json as a flat alias -> path map.
The `jump` subcommand prints a directory on stdout; the shell wrapper
(see `simpledir init`) does the actual cd.
"""

from __future__ import annotations

import argparse
import difflib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path

CONFIG_DIR = Path(os.environ.get("SIMPLEDIR_CONFIG_DIR", Path.home() / ".simpledir"))
CONFIG_FILE = CONFIG_DIR / "config.json"
UPDATE_CACHE = CONFIG_DIR / "update-check.json"
VERSION = "3.1.0"
PROG = "simpledir"

REPO = "noxthedevwindev-greatest/simpledir"
RELEASE_API = f"https://api.github.com/repos/{REPO}/releases/latest"
RELEASE_ASSET = f"https://github.com/{REPO}/releases/latest/download/simpledir"

BANNER = f"{PROG} {VERSION} - the next zoxide"
COMMANDS = (
    "add", "rm", "rename", "ls", "jump", "edit", "import",
    "update", "uninstall", "doctor", "completions", "init",
)
CHECK_INTERVAL = 86400  # at most one network round trip per day

RC_MARKERS = ("# >>> simpledir >>>", "# <<< simpledir <<<")


class UserError(Exception):
    """Something the user can fix. Printed without a traceback."""


# --------------------------------------------------------------------------- config


def load() -> dict:
    try:
        raw = CONFIG_FILE.read_text()
    except FileNotFoundError:
        return {"version": 1, "aliases": {}}
    except OSError as exc:
        raise UserError(f"can't read {CONFIG_FILE}: {exc}") from exc

    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise UserError(
            f"{CONFIG_FILE} is not valid JSON ({exc}).\n"
            f"  fix it by hand, or nuke it: rm {CONFIG_DIR}"
        ) from exc

    if not isinstance(data, dict) or not isinstance(data.get("aliases"), dict):
        raise UserError(
            f"{CONFIG_FILE} is missing an \"aliases\" object.\n"
            f"  expected: {{'version': 1, 'aliases': {{'name': '/path'}}}}"
        )
    return data


def save(data: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    payload = json.dumps(data, indent=2, sort_keys=True) + "\n"

    # atomic: never leave a half-written config behind
    fd, tmp = tempfile.mkstemp(dir=CONFIG_DIR, prefix=".config.", suffix=".json")
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(payload)
        os.replace(tmp, CONFIG_FILE)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


# ------------------------------------------------------------------------- helpers


def normalize(path: str) -> str:
    """Absolute, symlink-resolved, ~-collapsed path."""
    expanded = os.path.expanduser(os.path.expandvars(path))
    return str(Path(expanded).resolve())


def resolve(spec: str, aliases: dict) -> str:
    """Turn `name` or `name/sub/dir` into an existing absolute directory.

    Suffixes cost nothing to support and turn a flat map into something you can
    navigate deeply: `sd dots/src` is `<dots>/src`.
    """
    name, slash, suffix = spec.partition("/")
    if not name:
        raise UserError(
            f"'{spec}' isn't an alias, it's a path\n"
            f"  bind it first: {PROG} add <name> {spec}"
        )
    if name not in aliases:
        raise UserError(suggest(name, aliases))

    target = normalize(aliases[name])
    if slash and suffix:
        target = os.path.normpath(os.path.join(target, suffix))

    if not os.path.isdir(target):
        where = f"'{name}'" if not suffix else f"'{spec}'"
        raise UserError(
            f"alias {where} resolves to {target}\n"
            f"  that directory is gone. fix it: {PROG} add --force {name} <new-path>"
        )
    return target


def suggest(alias: str, aliases: dict) -> str:
    """Error text for an unknown alias, with near-misses if any."""
    msg = f"no alias named '{alias}'"
    names = sorted(aliases)
    hits = [n for n in names if alias.lower() in n.lower()]
    hits += [n for n in difflib.get_close_matches(alias, names, n=3, cutoff=0.6) if n not in hits]
    if hits:
        msg += "\n  did you mean: " + ", ".join(hits[:3])
    if not names:
        msg += f"\n  your config is empty. add one: {PROG} add <name> [path]"
    else:
        msg += f"\n  see them all: {PROG} ls"
    return msg


def die(msg: str) -> "NoReturn":  # noqa: F821
    print(f"{PROG}: {msg}", file=sys.stderr)
    raise SystemExit(1)


# ------------------------------------------------------------------- updates


def parse_version(text: str) -> tuple:
    parts = tuple(int(n) for n in re.findall(r"\d+", str(text))[:3])
    return parts or (0,)


def is_newer(candidate: str, current: str = VERSION) -> bool:
    return parse_version(candidate) > parse_version(current)


def _fetch(url: str, timeout: float) -> bytes:
    request = urllib.request.Request(
        url, headers={"User-Agent": f"{PROG}/{VERSION}", "Accept": "application/vnd.github+json"}
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return response.read()


def latest_release(timeout: float = 4.0) -> str | None:
    """Newest published version as a plain 'x.y.z'. None if we can't tell.

    Never raises: an update check is not worth breaking somebody's `cd` over.
    """
    url = os.environ.get("SIMPLEDIR_UPDATE_URL", RELEASE_API)
    try:
        payload = json.loads(_fetch(url, timeout))
        tag = str(payload.get("tag_name") or "")
    except Exception:
        return None
    return tag.lstrip("v") or None


def read_cache() -> dict:
    try:
        data = json.loads(UPDATE_CACHE.read_text())
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def write_cache(latest: str | None) -> None:
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        UPDATE_CACHE.write_text(json.dumps({"checked": int(time.time()), "latest": latest}))
    except OSError:
        pass  # a read-only home shouldn't break `ls`


def install_target() -> Path:
    """Where `update` should put the new version."""
    override = os.environ.get("SIMPLEDIR_BIN")
    if override:
        return Path(override)
    standard = Path.home() / ".local/bin/simpledir"
    if standard.exists():
        return standard  # what install.sh made; don't scribble in a git checkout
    running = Path(sys.argv[0]).resolve()
    if running.is_file() and os.access(running, os.W_OK):
        return running
    return standard


def nudge() -> None:
    """One stderr line if a newer release exists. At most one check a day.

    Skipped when stderr isn't a terminal, so scripts and pipes stay silent.
    """
    if os.environ.get("SIMPLEDIR_NO_UPDATE_CHECK") or not sys.stderr.isatty():
        return

    cache = read_cache()
    now = int(time.time())
    latest = cache.get("latest")
    if not latest or now - int(cache.get("checked", 0) or 0) > CHECK_INTERVAL:
        latest = latest_release()
        if latest:
            write_cache(latest)
        else:
            return  # offline, rate limited, api changed: say nothing, ever

    if latest and is_newer(latest):
        print(
            f"{PROG}: v{latest} is out (you're on v{VERSION}). `{PROG} update` installs it.",
            file=sys.stderr,
        )


# -------------------------------------------------------------------------- commands


def cmd_add(args: argparse.Namespace) -> int:
    raw = args.path or os.getcwd()
    target = normalize(raw)
    if not os.path.isdir(target):
        die(f"not a directory: {target}")

    name = args.name
    derived = Path(target).name
    if name is None:
        # no name given: use the directory's own name. `cd dotfiles && simpledir add`
        name = derived
        if not name:
            die(f"can't derive a name from {target}. usage: {PROG} add <name> [path]")

    data = load()
    aliases = data["aliases"]
    if name in aliases and not args.force:
        die(f"alias '{name}' already exists -> {aliases[name]}\n  overwrite: {PROG} add --force {name} {target}")

    aliases[name] = target
    save(data)
    print(f"{name} -> {target}")
    if derived and name != derived:
        print(f"  rename it: {PROG} rename {name} <other-name>")
    nudge()
    return 0


def cmd_rm(args: argparse.Namespace) -> int:
    data = load()
    aliases = data["aliases"]
    if args.name not in aliases:
        die(suggest(args.name, aliases))
    print(f"removed {args.name} -> {aliases.pop(args.name)}")
    save(data)
    return 0


def cmd_rename(args: argparse.Namespace) -> int:
    data = load()
    aliases = data["aliases"]
    if args.old not in aliases:
        die(suggest(args.old, aliases))
    if args.new in aliases and not args.force:
        die(f"alias '{args.new}' already exists -> {aliases[args.new]}\n  overwrite: {PROG} rename --force {args.old} {args.new}")
    target = aliases.pop(args.old)
    aliases[args.new] = target
    save(data)
    print(f"{args.old} -> {args.new} ({target})")
    return 0


def rows(aliases: dict, query: str | None = None) -> list[tuple]:
    """(name, absolute target, missing?) sorted by name, optionally filtered."""
    out = []
    for name in sorted(aliases):
        target = normalize(aliases[name])
        if query and query.lower() not in name.lower() and query.lower() not in target.lower():
            continue
        out.append((name, target, not os.path.isdir(target)))
    return out


def cmd_ls(args: argparse.Namespace) -> int:
    aliases = load()["aliases"]
    found = rows(aliases, args.query)

    if args.names:
        for name, _, _ in found:
            print(name)
        return 0 if found else 1

    if args.json:
        # same shape as the config file, so it can be piped straight back
        print(json.dumps({"version": 1, "aliases": {n: t for n, t, _ in found}}, indent=2, sort_keys=True))
        return 0 if found else 1

    if not found:
        if aliases and args.query:
            print(f"nothing matches '{args.query}'. see them all: {PROG} ls", file=sys.stderr)
        else:
            print(f"no aliases yet. add one: {PROG} add", file=sys.stderr)
        return 1

    width = max(len(name) for name, _, _ in found)
    for name, target, missing in found:
        gone = "   [missing]" if missing else ""
        shown = target
        if not args.long:
            try:
                relative = os.path.relpath(target, os.getcwd())
            except ValueError:
                pass  # different drive / unresolvable; absolute is the honest answer
            else:
                # a path full of ../ is noise, so keep the absolute one
                if not relative.startswith(".."):
                    shown = relative
        print(f"{name.ljust(width)}  {shown}{gone}")
    nudge()
    return 0


def cmd_edit(args: argparse.Namespace) -> int:
    """Open the config in $EDITOR. The JSON is the UI, in the end."""
    if not CONFIG_FILE.exists():
        save({"version": 1, "aliases": {}})
    editor = args.editor or os.environ.get("EDITOR") or os.environ.get("VISUAL") or "vi"
    argv = shlex.split(editor) + [str(CONFIG_FILE)]
    try:
        os.execvp(argv[0], argv)
    except OSError as exc:
        die(f"can't run editor {argv[0]!r}: {exc}")
    return 0  # unreachable unless exec fails silently


def cmd_jump(args: argparse.Namespace) -> int:
    aliases = load()["aliases"]
    print(resolve(args.name, aliases))
    return 0


def cmd_import(args: argparse.Namespace) -> int:
    """Bind every subdirectory of a tree in one shot.

    The 'I have twelve projects and don't want to type this twelve times'
    command. Depth-limited and it skips anything already bound.
    """
    root = normalize(args.directory)
    if not os.path.isdir(root):
        die(f"not a directory: {root}")

    found: list[tuple] = []
    for dirpath, dirnames, _ in os.walk(root):
        relative = os.path.relpath(dirpath, root)
        depth = 0 if relative == "." else relative.count(os.sep) + 1
        if depth >= args.depth:
            dirnames[:] = []  # don't descend any further
        if not args.hidden:
            dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        if relative == ".":
            continue
        found.append((args.prefix + os.path.basename(dirpath), dirpath))

    if not found:
        die(f"nothing to import under {root} at depth {args.depth}")

    data = load()
    aliases = data["aliases"]
    bound, skipped = [], []
    for name, target in sorted(found):
        if name in aliases and not args.force:
            skipped.append(name)
            continue
        aliases[name] = normalize(target)
        bound.append(name)

    if bound and not args.dry_run:
        save(data)

    verb = "would bind" if args.dry_run else "bound"
    print(f"{verb} {len(bound)}: " + " ".join(bound))
    if skipped:
        print(f"skipped {len(skipped)} already bound: " + " ".join(skipped))
        if not args.force:
            print(f"  overwrite them: {PROG} import --force {args.directory}")
    return 0


def cmd_update(args: argparse.Namespace) -> int:
    latest = latest_release(timeout=15)
    if not latest:
        die(f"couldn't reach GitHub to check for updates. try again, or see {REPO}")

    print(f"{PROG} {VERSION} installed, newest release is v{latest}")
    if not is_newer(latest):
        write_cache(latest)
        print("you're up to date")
        return 0

    target = install_target()
    if args.check:
        print(f"update available: v{latest} (exit 1 means 'there is one')")
        return 1

    if not args.yes:
        if not sys.stdin.isatty():
            print(f"  not a terminal, so not asking. install it with: {PROG} update --yes")
            return 1
        answer = input(f"  install v{latest} over {target}? [y/N] ").strip().lower()
        if answer not in ("y", "yes"):
            print("  ok, leaving it alone")
            return 0

    url = os.environ.get("SIMPLEDIR_UPDATE_ASSET_URL", RELEASE_ASSET)
    try:
        blob = _fetch(url, 30)
    except Exception as exc:
        die(f"download failed: {exc}")

    # verify what we downloaded before it replaces a working install
    with tempfile.TemporaryDirectory() as scratch:
        probe = Path(scratch) / "candidate"
        probe.write_bytes(blob)
        probe.chmod(0o755)
        try:
            reported = subprocess.run(
                [str(probe), "--version"], capture_output=True, text=True, timeout=20
            ).stdout.strip()
        except (OSError, subprocess.SubprocessError) as exc:
            die(f"downloaded file isn't runnable: {exc}")
        if not reported.startswith(f"{PROG} "):
            die(f"downloaded file isn't {PROG}: {reported or '<no output>'}")
        new_version = reported.split()[1].lstrip("v")

    if not is_newer(new_version, VERSION):
        print(f"  asset is v{new_version}, same as what you have. not changing anything")
        write_cache(new_version)
        return 0

    target.parent.mkdir(parents=True, exist_ok=True)
    staged = target.with_name(target.name + f".new.{os.getpid()}")
    staged.write_bytes(blob)
    staged.chmod(0o755)
    os.replace(staged, target)  # atomic: never a half-written binary in your PATH
    write_cache(new_version)
    print(f"updated to v{new_version} at {target}")
    print(f"  new shell needed if {PROG} init gained subcommands")
    return 0


def rc_candidates() -> list:
    """rc files that might hold a wrapper block, most likely first.

    SIMPLEDIR_RC is exclusive when set: it names the one file to touch, and
    nothing else is considered. otherwise it's guessed from $SHELL plus the
    usual suspects.
    """
    if os.environ.get("SIMPLEDIR_RC"):
        return [Path(os.environ["SIMPLEDIR_RC"])]

    home = Path.home()
    candidates = []
    if "zsh" in os.environ.get("SHELL", ""):
        candidates.append(Path(os.environ.get("ZDOTDIR") or home) / ".zshrc")
    candidates += [home / ".bashrc", home / ".zshrc", home / ".config/fish/config.fish"]

    unique = []
    for path in candidates:
        if path not in unique:
            unique.append(path)
    return unique


def strip_rc_block(text: str) -> tuple:
    """Remove every `>>> simpledir >>>` … `<<< simpledir <<<` span."""
    begin, end = RC_MARKERS
    kept, inside, found = [], False, False
    for line in text.splitlines(keepends=True):
        stripped = line.strip()
        if stripped == begin:
            inside, found = True, True
            continue
        if stripped == end:
            inside = False
            continue
        if not inside:
            kept.append(line)
    return "".join(kept), found


def cmd_uninstall(args: argparse.Namespace) -> int:
    """Remove the install: the binary, and the wrapper block from shell rc.

    Your aliases are data, not installation, so they stay unless --purge.
    """
    target = install_target()
    try:
        count = len(load()["aliases"])
    except UserError:
        count = 0

    # be explicit: we may be removing a different copy than the one running
    running = Path(sys.argv[0]).resolve()
    if target != running:
        print(f"note: removing {target}, not the copy you're running ({running})")

    if count and not args.purge:
        print(f"you have {count} alias{'es' if count != 1 else ''} in {CONFIG_FILE}")
        print(f"  these stay. to remove them too: {PROG} uninstall --purge")

    if not args.yes:
        if not sys.stdin.isatty():
            die("not a terminal, so not asking. re-run with --yes")
        answer = input(f"  remove {target} and the wrapper from your shell rc? [y/N] ").strip().lower()
        if answer not in ("y", "yes"):
            print("  ok, nothing changed")
            return 0

    touched = []
    for rc in rc_candidates():
        try:
            if not rc.is_file():
                continue
            original = rc.read_text(errors="replace")
        except OSError:
            continue
        cleaned, found = strip_rc_block(original)
        if not found:
            continue
        backup = rc.with_name(rc.name + f".bak.{time.strftime('%Y%m%d%H%M%S')}")
        try:
            shutil.copy2(rc, backup)
            staged = rc.with_name(rc.name + f".new.{os.getpid()}")
            staged.write_text(cleaned)
            os.replace(staged, rc)
        except OSError as exc:
            die(f"couldn't rewrite {rc}: {exc}\n  the original is still there")
        touched.append((str(rc), str(backup)))

    if not touched:
        print("no wrapper block found in any shell rc")

    # unlinking a running script is fine on unix: the inode survives until exit
    if target.is_file():
        try:
            target.unlink()
        except OSError as exc:
            print(f"couldn't remove {target}: {exc}")
            print(f"  remove it by hand: rm {target}")
        else:
            print(f"removed {target}")
    else:
        print(f"nothing to remove at {target}")

    for rc, backup in touched:
        print(f"cleaned the wrapper from {rc} (backup: {backup})")

    if args.purge:
        if CONFIG_DIR.exists():
            shutil.rmtree(CONFIG_DIR, ignore_errors=True)
            print(f"deleted {CONFIG_DIR} and every alias in it")
    else:
        print(f"aliases kept in {CONFIG_FILE}")

    print("open a new shell, or `exec bash`, to drop the old functions")
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    problems = 0

    def ok(msg: str) -> None:
        print(f"  \033[32mok\033[0m    {msg}")

    def bad(msg: str) -> None:
        nonlocal problems
        problems += 1
        print(f"  \033[31mproblem\033[0m {msg}")

    def note(msg: str) -> None:
        print(f"  \033[2mnote\033[0m    {msg}")

    print(f"{PROG} doctor - version {VERSION}")
    print("runtime")
    ok(f"python {sys.version.split()[0]}")

    print("config")
    if CONFIG_FILE.exists():
        ok(f"{CONFIG_FILE}")
        try:
            aliases = load()["aliases"]
        except UserError as exc:
            bad(str(exc).splitlines()[0])
            aliases = {}
        else:
            ok(f"{len(aliases)} alias{'es' if len(aliases) != 1 else ''}")
            for name, target, missing in rows(aliases):
                if missing:
                    bad(f"'{name}' -> {target} is gone. rebind: {PROG} add --force {name} <path>")
                if name != name.strip() or name.startswith("-") or " " in name:
                    bad(f"alias name {name!r} has whitespace or a leading dash")
    else:
        bad(f"no config yet at {CONFIG_FILE}. create one: {PROG} add")

    print("shell")
    wired = []
    for rc in rc_candidates():
        try:
            if rc.is_file() and RC_MARKERS[0] in rc.read_text(errors="replace"):
                wired.append(str(rc))
        except OSError:
            pass
    if wired:
        for rc in wired:
            ok(f"wrapper wired into {rc}")
    else:
        target_rc = "~/.zshrc" if "zsh" in os.environ.get("SHELL", "") else "~/.bashrc"
        bad(f"no shell wrapper found. add it: {PROG} init >> {target_rc}")

    binary_dir = str(install_target().parent)
    if binary_dir in os.environ.get("PATH", "").split(os.pathsep):
        ok(f"{binary_dir} is in PATH")
    else:
        bad(f"{binary_dir} is not in PATH. add: export PATH=\"{binary_dir}:$PATH\"")

    cached = read_cache().get("latest")
    print("updates")
    if cached:
        ok(f"last known release: v{cached}")
    else:
        note(f"never checked. run `{PROG} update --check`")
    if os.environ.get("SIMPLEDIR_NO_UPDATE_CHECK"):
        note("update checks are disabled (SIMPLEDIR_NO_UPDATE_CHECK)")

    print()
    if problems:
        print(f"{problems} problem{'s' if problems != 1 else ''} found")
        return 1
    print("everything looks fine")
    return 0


def cmd_completions(args: argparse.Namespace) -> int:
    if args.shell == "bash":
        print(
            f"""# {PROG} bash completion. source this, or install it:
#   {PROG} completions bash > /usr/share/bash-completion/completions/{PROG}
_{PROG}_complete() {{
  local cur names
  cur="${{COMP_WORDS[COMP_CWORD]}}"
  names=$(command {PROG} ls --names 2>/dev/null)
  COMPREPLY=( $(compgen -W "$names" -- "$cur") )
  if [[ ${{#COMPREPLY[@]}} -eq 0 && -d "$cur" ]]; then
    # let the shell complete directories too: `sd dots/<tab>`
    COMPREPLY=( $(compgen -d -- "$cur") )
  fi
}}
complete -o filenames -F _{PROG}_complete {PROG} sd
"""
        )
    else:
        print(
            f"""#compdef {PROG} sd
# {PROG} zsh completion. requires compinit; put this in ~/.zshrc:
#   {PROG} completions zsh > "${{fpath[1]}}/_{PROG}"
local -a _sd_aliases
_sd_aliases=(${{(f)"$(command {PROG} ls --names 2>/dev/null)"}})
_arguments '1: :->alias' '*: :_files -/'
if [[ $state == alias ]]; then
  _describe -t aliases 'directory alias' _sd_aliases
fi
"""
        )
    return 0


def cmd_init(args: argparse.Namespace) -> int:
    bindir = str(Path(shutil.which(PROG) or sys.argv[0]).resolve().parent)
    passthrough = "|".join((*COMMANDS, "help", "-h", "-V", "--version", "--help"))
    print(
        f"""# simpledir - the next zoxide. drop this in your shell rc
if ! command -v {PROG} >/dev/null 2>&1; then
  case ":$PATH:" in
    *":{bindir}:"*) ;;
    *) export PATH="{bindir}:$PATH" ;;
  esac
fi

# a subprocess can't change this shell's cwd, so the cd happens here.
_{PROG}_jump() {{
  case "${{1-}}" in
    -)  builtin cd -- "$OLDPWD" && return $? ;;
    "") builtin cd -- "$HOME" && return $? ;;
    /* | ~*)  builtin cd -- "$1" && return $? ;;   # sd /some/path just works
  esac
  local _sd_dir
  _sd_dir=$(command {PROG} jump "$@") || return $?
  builtin cd -- "$_sd_dir"
}}

# `sd <alias>` jumps
sd() {{ _{PROG}_jump "$@"; }}

# `simpledir <alias>` jumps too; subcommands go to the real binary.
{PROG}() {{
  case "${{1-}}" in
    "" | -)             _{PROG}_jump "$@" ;;
    {passthrough}) command {PROG} "$@" ;;
    -?*)                command {PROG} "$@" ;;
    *)                  _{PROG}_jump "$@" ;;
  esac
}}
"""
    )
    return 0


# ----------------------------------------------------------------------------- main


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="the next zoxide - named directory shortcuts for your shell",
        epilog="bare `simpledir <alias>` is a shortcut for `simpledir jump <alias>`",
    )
    parser.add_argument("-V", "--version", action="version", version=BANNER)
    sub = parser.add_subparsers(dest="cmd")

    p = sub.add_parser("add", help="bind an alias to a directory (defaults: name from the dir, path to $PWD)")
    p.add_argument("name", nargs="?", help="alias name; omit to use the directory's own name")
    p.add_argument("path", nargs="?", help="directory to bind; omit for $PWD")
    p.add_argument("-f", "--force", action="store_true", help="overwrite an existing alias")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("rm", help="delete an alias")
    p.add_argument("name")
    p.set_defaults(func=cmd_rm)

    p = sub.add_parser("rename", help="change an alias's name, keeping its path")
    p.add_argument("old")
    p.add_argument("new")
    p.add_argument("-f", "--force", action="store_true", help="overwrite an existing alias")
    p.set_defaults(func=cmd_rename)

    p = sub.add_parser("ls", help="list aliases, optionally filtered by a substring")
    p.add_argument("query", nargs="?", help="only aliases whose name or path contains this")
    p.add_argument("-l", "--long", action="store_true", help="always print absolute paths")
    p.add_argument("--names", action="store_true", help="one alias per line, for completion scripts")
    p.add_argument("--json", action="store_true", dest="json", help="print the same shape as the config file")
    p.set_defaults(func=cmd_ls)

    p = sub.add_parser("jump", help="print the directory for an alias (used by `sd`)")
    p.add_argument("name", help="an alias, optionally with a path: `dots/src`")
    p.set_defaults(func=cmd_jump)

    p = sub.add_parser("edit", help="open the config in $EDITOR")
    p.add_argument("editor", nargs="?", help="editor command; defaults to $EDITOR")
    p.set_defaults(func=cmd_edit)

    p = sub.add_parser("import", help="bind every subdirectory of a tree in one shot")
    p.add_argument("directory", help="tree to walk, e.g. ~/Projects")
    p.add_argument("-d", "--depth", type=int, default=1, help="how many levels to bind (default 1)")
    p.add_argument("-p", "--prefix", default="", help="namespace the names, e.g. `proj-`")
    p.add_argument("-f", "--force", action="store_true", help="overwrite existing aliases")
    p.add_argument("--hidden", action="store_true", help="include dot-directories")
    p.add_argument("-n", "--dry-run", action="store_true", help="show what would happen, change nothing")
    p.set_defaults(func=cmd_import)

    p = sub.add_parser("update", help="check for a newer release and install it")
    p.add_argument("--check", action="store_true", help="only report; exit 1 if an update exists")
    p.add_argument("-y", "--yes", action="store_true", help="don't ask, just install")
    p.set_defaults(func=cmd_update)

    p = sub.add_parser("doctor", help="check the install: config, dead aliases, shell wiring, PATH")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser(
        "uninstall",
        help="remove the install: binary and shell wrapper (aliases kept unless --purge)",
    )
    p.add_argument("--purge", action="store_true", help="also delete ~/.simpledir and every alias")
    p.add_argument("-y", "--yes", action="store_true", help="don't ask, just do it")
    p.set_defaults(func=cmd_uninstall)

    p = sub.add_parser("completions", help="print a shell completion script")
    p.add_argument("shell", choices=("bash", "zsh"))
    p.set_defaults(func=cmd_completions)

    p = sub.add_parser("init", help="print the shell wrapper")
    p.set_defaults(func=cmd_init)

    return parser


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    # bare `simpledir <alias>` is shorthand for `simpledir jump <alias>`
    if len(argv) == 1 and argv[0] not in COMMANDS and not argv[0].startswith("-"):
        argv = ["jump", argv[0]]

    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return 0
    try:
        return args.func(args)
    except UserError as exc:
        die(str(exc))
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
