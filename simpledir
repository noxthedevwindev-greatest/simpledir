#!/usr/bin/env python3
"""simpledir - the next zoxide. named directory shortcuts for your shell.

Config lives in ~/.simpledir/config.json as a flat alias -> path map.
The `jump` subcommand prints a directory on stdout; the shell wrapper
(see `simpledir init`) does the actual cd.
"""

from __future__ import annotations

import argparse
import difflib
import json
import os
import shlex
import shutil
import sys
import tempfile
from pathlib import Path

CONFIG_DIR = Path(os.environ.get("SIMPLEDIR_CONFIG_DIR", Path.home() / ".simpledir"))
CONFIG_FILE = CONFIG_DIR / "config.json"
VERSION = "2.0.0"
PROG = "simpledir"

BANNER = f"{PROG} {VERSION} - the next zoxide"
COMMANDS = ("add", "rm", "rename", "ls", "jump", "edit", "completions", "init")


class UserError(Exception):
    """Something the user can fix. Printed without a traceback."""


# --------------------------------------------------------------------------- config


def load() -> dict:
    try:
        raw = CONFIG_FILE.read_text()
    except FileNotFoundError:
        return {"version": 1, "aliases": {}}
    except OSError as exc:
        raise UserError(f"can't read {CONFIG_FILE}: {exc}") from exc

    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise UserError(
            f"{CONFIG_FILE} is not valid JSON ({exc}).\n"
            f"  fix it by hand, or nuke it: rm {CONFIG_DIR}"
        ) from exc

    if not isinstance(data, dict) or not isinstance(data.get("aliases"), dict):
        raise UserError(
            f"{CONFIG_FILE} is missing an \"aliases\" object.\n"
            f"  expected: {{'version': 1, 'aliases': {{'name': '/path'}}}}"
        )
    return data


def save(data: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    payload = json.dumps(data, indent=2, sort_keys=True) + "\n"

    # atomic: never leave a half-written config behind
    fd, tmp = tempfile.mkstemp(dir=CONFIG_DIR, prefix=".config.", suffix=".json")
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(payload)
        os.replace(tmp, CONFIG_FILE)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


# ------------------------------------------------------------------------- helpers


def normalize(path: str) -> str:
    """Absolute, symlink-resolved, ~-collapsed path."""
    expanded = os.path.expanduser(os.path.expandvars(path))
    return str(Path(expanded).resolve())


def resolve(spec: str, aliases: dict) -> str:
    """Turn `name` or `name/sub/dir` into an existing absolute directory.

    Suffixes cost nothing to support and turn a flat map into something you can
    navigate deeply: `sd dots/src` is `<dots>/src`.
    """
    name, slash, suffix = spec.partition("/")
    if not name:
        raise UserError(
            f"'{spec}' isn't an alias, it's a path\n"
            f"  bind it first: {PROG} add <name> {spec}"
        )
    if name not in aliases:
        raise UserError(suggest(name, aliases))

    target = normalize(aliases[name])
    if slash and suffix:
        target = os.path.normpath(os.path.join(target, suffix))

    if not os.path.isdir(target):
        where = f"'{name}'" if not suffix else f"'{spec}'"
        raise UserError(
            f"alias {where} resolves to {target}\n"
            f"  that directory is gone. fix it: {PROG} add --force {name} <new-path>"
        )
    return target


def suggest(alias: str, aliases: dict) -> str:
    """Error text for an unknown alias, with near-misses if any."""
    msg = f"no alias named '{alias}'"
    names = sorted(aliases)
    hits = [n for n in names if alias.lower() in n.lower()]
    hits += [n for n in difflib.get_close_matches(alias, names, n=3, cutoff=0.6) if n not in hits]
    if hits:
        msg += "\n  did you mean: " + ", ".join(hits[:3])
    if not names:
        msg += f"\n  your config is empty. add one: {PROG} add <name> [path]"
    else:
        msg += f"\n  see them all: {PROG} ls"
    return msg


def die(msg: str) -> "NoReturn":  # noqa: F821
    print(f"{PROG}: {msg}", file=sys.stderr)
    raise SystemExit(1)


# -------------------------------------------------------------------------- commands


def cmd_add(args: argparse.Namespace) -> int:
    raw = args.path or os.getcwd()
    target = normalize(raw)
    if not os.path.isdir(target):
        die(f"not a directory: {target}")

    name = args.name
    derived = Path(target).name
    if name is None:
        # no name given: use the directory's own name. `cd dotfiles && simpledir add`
        name = derived
        if not name:
            die(f"can't derive a name from {target}. usage: {PROG} add <name> [path]")

    data = load()
    aliases = data["aliases"]
    if name in aliases and not args.force:
        die(f"alias '{name}' already exists -> {aliases[name]}\n  overwrite: {PROG} add --force {name} {target}")

    aliases[name] = target
    save(data)
    print(f"{name} -> {target}")
    if derived and name != derived:
        print(f"  rename it: {PROG} rename {name} <other-name>")
    return 0


def cmd_rm(args: argparse.Namespace) -> int:
    data = load()
    aliases = data["aliases"]
    if args.name not in aliases:
        die(suggest(args.name, aliases))
    print(f"removed {args.name} -> {aliases.pop(args.name)}")
    save(data)
    return 0


def cmd_rename(args: argparse.Namespace) -> int:
    data = load()
    aliases = data["aliases"]
    if args.old not in aliases:
        die(suggest(args.old, aliases))
    if args.new in aliases and not args.force:
        die(f"alias '{args.new}' already exists -> {aliases[args.new]}\n  overwrite: {PROG} rename --force {args.old} {args.new}")
    target = aliases.pop(args.old)
    aliases[args.new] = target
    save(data)
    print(f"{args.old} -> {args.new} ({target})")
    return 0


def rows(aliases: dict, query: str | None = None) -> list[tuple]:
    """(name, absolute target, missing?) sorted by name, optionally filtered."""
    out = []
    for name in sorted(aliases):
        target = normalize(aliases[name])
        if query and query.lower() not in name.lower() and query.lower() not in target.lower():
            continue
        out.append((name, target, not os.path.isdir(target)))
    return out


def cmd_ls(args: argparse.Namespace) -> int:
    aliases = load()["aliases"]
    found = rows(aliases, args.query)

    if args.names:
        for name, _, _ in found:
            print(name)
        return 0 if found else 1

    if args.json:
        # same shape as the config file, so it can be piped straight back
        print(json.dumps({"version": 1, "aliases": {n: t for n, t, _ in found}}, indent=2, sort_keys=True))
        return 0 if found else 1

    if not found:
        if aliases and args.query:
            print(f"nothing matches '{args.query}'. see them all: {PROG} ls", file=sys.stderr)
        else:
            print(f"no aliases yet. add one: {PROG} add", file=sys.stderr)
        return 1

    width = max(len(name) for name, _, _ in found)
    for name, target, missing in found:
        gone = "   [missing]" if missing else ""
        shown = target
        if not args.long:
            try:
                relative = os.path.relpath(target, os.getcwd())
            except ValueError:
                pass  # different drive / unresolvable; absolute is the honest answer
            else:
                # a path full of ../ is noise, so keep the absolute one
                if not relative.startswith(".."):
                    shown = relative
        print(f"{name.ljust(width)}  {shown}{gone}")
    return 0


def cmd_edit(args: argparse.Namespace) -> int:
    """Open the config in $EDITOR. The JSON is the UI, in the end."""
    if not CONFIG_FILE.exists():
        save({"version": 1, "aliases": {}})
    editor = args.editor or os.environ.get("EDITOR") or os.environ.get("VISUAL") or "vi"
    argv = shlex.split(editor) + [str(CONFIG_FILE)]
    try:
        os.execvp(argv[0], argv)
    except OSError as exc:
        die(f"can't run editor {argv[0]!r}: {exc}")
    return 0  # unreachable unless exec fails silently


def cmd_jump(args: argparse.Namespace) -> int:
    aliases = load()["aliases"]
    print(resolve(args.name, aliases))
    return 0


def cmd_completions(args: argparse.Namespace) -> int:
    if args.shell == "bash":
        print(
            f"""# {PROG} bash completion. source this, or install it:
#   {PROG} completions bash > /usr/share/bash-completion/completions/{PROG}
_{PROG}_complete() {{
  local cur names
  cur="${{COMP_WORDS[COMP_CWORD]}}"
  names=$(command {PROG} ls --names 2>/dev/null)
  COMPREPLY=( $(compgen -W "$names" -- "$cur") )
  if [[ ${{#COMPREPLY[@]}} -eq 0 && -d "$cur" ]]; then
    # let the shell complete directories too: `sd dots/<tab>`
    COMPREPLY=( $(compgen -d -- "$cur") )
  fi
}}
complete -o filenames -F _{PROG}_complete {PROG} sd
"""
        )
    else:
        print(
            f"""#compdef {PROG} sd
# {PROG} zsh completion. requires compinit; put this in ~/.zshrc:
#   {PROG} completions zsh > "${{fpath[1]}}/_{PROG}"
local -a _sd_aliases
_sd_aliases=(${{(f)"$(command {PROG} ls --names 2>/dev/null)"}})
_arguments '1: :->alias' '*: :_files -/'
if [[ $state == alias ]]; then
  _describe -t aliases 'directory alias' _sd_aliases
fi
"""
        )
    return 0


def cmd_init(args: argparse.Namespace) -> int:
    bindir = str(Path(shutil.which(PROG) or sys.argv[0]).resolve().parent)
    passthrough = "|".join((*COMMANDS, "help", "-h", "-V", "--version", "--help"))
    print(
        f"""# simpledir - the next zoxide. drop this in your shell rc
if ! command -v {PROG} >/dev/null 2>&1; then
  case ":$PATH:" in
    *":{bindir}:"*) ;;
    *) export PATH="{bindir}:$PATH" ;;
  esac
fi

# a subprocess can't change this shell's cwd, so the cd happens here.
_{PROG}_jump() {{
  case "${{1-}}" in
    -)  builtin cd -- "$OLDPWD" && return $? ;;
    "") builtin cd -- "$HOME" && return $? ;;
    /* | ~*)  builtin cd -- "$1" && return $? ;;   # sd /some/path just works
  esac
  local _sd_dir
  _sd_dir=$(command {PROG} jump "$@") || return $?
  builtin cd -- "$_sd_dir"
}}

# `sd <alias>` jumps
sd() {{ _{PROG}_jump "$@"; }}

# `simpledir <alias>` jumps too; subcommands go to the real binary.
{PROG}() {{
  case "${{1-}}" in
    "" | -)             _{PROG}_jump "$@" ;;
    {passthrough}) command {PROG} "$@" ;;
    -?*)                command {PROG} "$@" ;;
    *)                  _{PROG}_jump "$@" ;;
  esac
}}
"""
    )
    return 0


# ----------------------------------------------------------------------------- main


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="the next zoxide - named directory shortcuts for your shell",
        epilog="bare `simpledir <alias>` is a shortcut for `simpledir jump <alias>`",
    )
    parser.add_argument("-V", "--version", action="version", version=BANNER)
    sub = parser.add_subparsers(dest="cmd")

    p = sub.add_parser("add", help="bind an alias to a directory (defaults: name from the dir, path to $PWD)")
    p.add_argument("name", nargs="?", help="alias name; omit to use the directory's own name")
    p.add_argument("path", nargs="?", help="directory to bind; omit for $PWD")
    p.add_argument("-f", "--force", action="store_true", help="overwrite an existing alias")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("rm", help="delete an alias")
    p.add_argument("name")
    p.set_defaults(func=cmd_rm)

    p = sub.add_parser("rename", help="change an alias's name, keeping its path")
    p.add_argument("old")
    p.add_argument("new")
    p.add_argument("-f", "--force", action="store_true", help="overwrite an existing alias")
    p.set_defaults(func=cmd_rename)

    p = sub.add_parser("ls", help="list aliases, optionally filtered by a substring")
    p.add_argument("query", nargs="?", help="only aliases whose name or path contains this")
    p.add_argument("-l", "--long", action="store_true", help="always print absolute paths")
    p.add_argument("--names", action="store_true", help="one alias per line, for completion scripts")
    p.add_argument("--json", action="store_true", dest="json", help="print the same shape as the config file")
    p.set_defaults(func=cmd_ls)

    p = sub.add_parser("jump", help="print the directory for an alias (used by `sd`)")
    p.add_argument("name", help="an alias, optionally with a path: `dots/src`")
    p.set_defaults(func=cmd_jump)

    p = sub.add_parser("edit", help="open the config in $EDITOR")
    p.add_argument("editor", nargs="?", help="editor command; defaults to $EDITOR")
    p.set_defaults(func=cmd_edit)

    p = sub.add_parser("completions", help="print a shell completion script")
    p.add_argument("shell", choices=("bash", "zsh"))
    p.set_defaults(func=cmd_completions)

    p = sub.add_parser("init", help="print the shell wrapper")
    p.set_defaults(func=cmd_init)

    return parser


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    # bare `simpledir <alias>` is shorthand for `simpledir jump <alias>`
    if len(argv) == 1 and argv[0] not in COMMANDS and not argv[0].startswith("-"):
        argv = ["jump", argv[0]]

    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return 0
    try:
        return args.func(args)
    except UserError as exc:
        die(str(exc))
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
