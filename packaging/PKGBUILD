# Maintainer: NoxTheDev <https://github.com/noxthedevwindev-greatest>
# Contributor: Your Name <you@example.com>
pkgname=simpledir
pkgver=10.0.0
pkgrel=1
pkgdesc="Named directory shortcuts for your shell - a frecency-aware zoxide alternative"
arch=('x86_64' 'aarch64')
url="https://github.com/noxthedevwindev-greatest/simpledir"
license=('MIT')
depends=('curl')
optdepends=('bash: shell wrapper for bash' 'zsh: shell wrapper for zsh'
            'fzf: interactive picker for `sd i`')
makedepends=('g++')
# a git source pinned to the tag: bump pkgver, push the tag, the AUR follows.
# SKIP is only valid for VCS sources, which is exactly the point.
source=("$pkgname::git+https://github.com/noxthedevwindev-greatest/simpledir.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname"
  # one source file. linked statically when this system has a static libc,
  # because the dynamic loader costs more than the program does; falls back to
  # static libstdc++ (no glibc-static in the runtime closure) if it doesn't.
  if ! g++ -std=c++17 -O2 -static -ffunction-sections -fdata-sections \
       -Wl,--gc-sections -o sd sd.cpp 2>/dev/null; then
    g++ -std=c++17 -O2 -static-libstdc++ -static-libgcc -o sd sd.cpp
  fi
}

check() {
  cd "$srcdir/$pkgname"
  # the suite needs bash and a compiler; it compiles its own stub binaries
  bash tests/run.sh
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 sd "$pkgdir/usr/bin/sd"
  ln -s sd "$pkgdir/usr/bin/sdcfg"
  install -Dm644 sd.cpp "$pkgdir/usr/share/doc/$pkgname/sd.cpp"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 llms.txt "$pkgdir/usr/share/doc/$pkgname/llms.txt"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# the shell wrapper is opt-in: print how to enable it rather than editing
# anybody's bashrc from a post-install script.
post_install() {
  echo "run 'sdcfg init >> ~/.bashrc' (or ~/.zshrc) to enable 'sd'"
  echo "then 'sdcfg migrate' to bring an older config to v2, and 'sdcfg doctor' to check"
}
