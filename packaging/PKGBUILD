# Maintainer: NoxTheDev <https://github.com/noxthedevwindev-greatest>
# Contributor: Your Name <you@example.com>
pkgname=simpledir
pkgver=11.0.0
pkgrel=1
pkgdesc="Named directory shortcuts for your shell - a frecency-aware zoxide alternative"
arch=('x86_64' 'aarch64')
url="https://github.com/noxthedevwindev-greatest/simpledir"
license=('MIT')
depends=('curl')
optdepends=('bash: shell wrapper for bash' 'zsh: shell wrapper for zsh'
            'fzf: interactive picker for `sd i`')
makedepends=('g++')
# Pinned to the tag's own tarball, with a real checksum.
#
# This used to be a git source with `sha256sums=('SKIP')`, which is the AUR
# convention for VCS sources -- and it means makepkg verifies nothing at all. The
# convention is there because a git tag is mutable, but a *released* tag is the
# one case where the content is supposed to be fixed, so pinning the tarball and
# its sha256 is both possible and the thing you actually want: makepkg now refuses
# to build if the bytes differ from what this file names.
#
# Bumping a release means regenerating one line:
#   updpkgsums
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('e72e418da843bb9805d476d70029a08810d25d21ba86838274d8be933d6685df')
# GitHub regenerates these tarballs on occasion, which occasionally changes the
# hash for an unchanged tag. That is the trade for the guarantee above: a mismatch
# stops the build loudly instead of quietly installing different bytes.

build() {
  cd "$srcdir/$pkgname"
  # one source file. linked statically when this system has a static libc,
  # because the dynamic loader costs more than the program does; falls back to
  # static libstdc++ (no glibc-static in the runtime closure) if it doesn't.
  if ! g++ -std=c++17 -O2 -static -ffunction-sections -fdata-sections \
       -Wl,--gc-sections -o sd sd.cpp 2>/dev/null; then
    g++ -std=c++17 -O2 -static-libstdc++ -static-libgcc -o sd sd.cpp
  fi
}

check() {
  cd "$srcdir/$pkgname"
  # the suite needs bash and a compiler; it compiles its own stub binaries
  bash tests/run.sh
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 sd "$pkgdir/usr/bin/sd"
  ln -s sd "$pkgdir/usr/bin/sdcfg"
  install -Dm644 sd.cpp "$pkgdir/usr/share/doc/$pkgname/sd.cpp"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 llms.txt "$pkgdir/usr/share/doc/$pkgname/llms.txt"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# the shell wrapper is opt-in: print how to enable it rather than editing
# anybody's bashrc from a post-install script.
post_install() {
  echo "run 'sdcfg init >> ~/.bashrc' (or ~/.zshrc) to enable 'sd'"
  echo "then 'sdcfg migrate' to bring an older config to v2, and 'sdcfg doctor' to check"
}
