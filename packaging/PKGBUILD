# Maintainer: NoxTheDev <https://github.com/noxthedevwindev-greatest>
# Contributor: Your Name <you@example.com>
pkgname=simpledir
pkgver=14.0.0
pkgrel=1
pkgdesc="Named directory shortcuts for your shell - a frecency-aware zoxide alternative"
arch=('x86_64' 'aarch64')
url="https://github.com/noxthedevwindev-greatest/simpledir"
license=('MIT')
depends=('curl')
optdepends=('bash: shell wrapper for bash' 'zsh: shell wrapper for zsh'
            'fzf: interactive picker for `sd i`')
makedepends=('rust')
# Pinned to the tag's own tarball, with a real checksum.
#
# This used to be a git source with `sha256sums=('SKIP')`, which is the AUR
# convention for VCS sources -- and it means makepkg verifies nothing at all. The
# convention is there because a git tag is mutable, but a *released* tag is the
# one case where the content is supposed to be fixed, so pinning the tarball and
# its sha256 is both possible and the thing you actually want: makepkg now refuses
# to build if the bytes differ from what this file names.
#
# Bumping a release means regenerating one line:
#   updpkgsums
# Pinned to the published v14.0.0 archive. The checksum is of the tag's own
# source tarball, not of a release asset generated later. The tag has to exist
# before its archive can be hashed, so this line is filled right after tagging
# (v13 worked the same way).
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('2d0fe6a53e5f4f83f38a50d6c664c433a8e4269b7ad0be1c525e6af1440cac31')
# GitHub regenerates these tarballs on occasion, which occasionally changes the
# hash for an unchanged tag. That is the trade for the guarantee above: a mismatch
# stops the build loudly instead of quietly installing different bytes.

build() {
  cd "$srcdir/$pkgname-$pkgver"
  # one source file, std-only Rust 2021. linked statically when this system
  # has a static libc, because the dynamic loader costs more than the program
  # does; fall back to a dynamic link with a note rather than silently shipping
  # a slower binary.
  if rustc --edition 2021 -O -C strip=symbols -C target-feature=+crt-static \
       -o sd src/main.rs 2>/dev/null; then
    :
  else
    echo "note: no static libc here, linking dynamically" >&2
    rustc --edition 2021 -O -C strip=symbols -o sd src/main.rs
  fi
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  # the suite needs bash and rustc; it compiles its own stub binaries (legacy
  # C++ fixtures are optional and skipped when their compiler is absent)
  bash tests/run.sh
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 sd "$pkgdir/usr/bin/sd"
  ln -s sd "$pkgdir/usr/bin/sdcfg"
  install -Dm644 src/main.rs "$pkgdir/usr/share/doc/$pkgname/main.rs"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 llms.txt "$pkgdir/usr/share/doc/$pkgname/llms.txt"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# the shell wrapper is opt-in: print how to enable it rather than editing
# anybody's bashrc from a post-install script.
post_install() {
  echo "run 'sdcfg init >> ~/.bashrc' (or ~/.zshrc) to enable 'sd'"
  echo "then 'sdcfg migrate' to bring an older config up to date, and 'sdcfg doctor' to check"
}
